# 19. Zustand Store 구현 템플릿

## 19.1 surveyStore.js

```js
import { create } from 'zustand';
import {
  fetchPrimarySurveyApi,
  fetchDetailSurveyApi,
} from '../api/surveyApi.js';

export const useSurveyStore = create((set) => ({
  currentSurvey: null,
  questions: [],
  loading: false,
  error: null,

  fetchSurvey: async (examType) => {
    set({ loading: true, error: null });

    try {
      const data =
        examType === 'KDSQ_P'
          ? await fetchPrimarySurveyApi()
          : await fetchDetailSurveyApi();

      set({
        currentSurvey: data.survey,
        questions: data.questions,
      });
    } catch (err) {
      set({ error: err.message });
      throw err;
    } finally {
      set({ loading: false });
    }
  },

  clearSurvey: () => {
    set({
      currentSurvey: null,
      questions: [],
      error: null,
    });
  },
}));
```

## 19.2 examStore.js

```js
import { create } from 'zustand';
import {
  submitPrimaryExamApi,
  submitDetailExamApi,
  fetchExamResultApi,
  fetchExamHistoryApi,
} from '../api/examApi.js';

export const useExamStore = create((set, get) => ({
  answers: {},
  currentResult: null,
  history: [],
  submitting: false,
  loading: false,
  error: null,

  setAnswer: (questionId, score) => {
    set((state) => ({
      answers: {
        ...state.answers,
        [questionId]: score,
      },
    }));
  },

  clearAnswers: () => set({ answers: {} }),

  submitPrimaryExam: async (answers) => {
    set({ submitting: true, error: null });

    try {
      const result = await submitPrimaryExamApi(answers);
      set({ currentResult: result });
      return result;
    } catch (err) {
      set({ error: err.message });
      throw err;
    } finally {
      set({ submitting: false });
    }
  },

  submitDetailExam: async (answers) => {
    set({ submitting: true, error: null });

    try {
      const result = await submitDetailExamApi(answers);
      set({ currentResult: result });
      return result;
    } catch (err) {
      set({ error: err.message });
      throw err;
    } finally {
      set({ submitting: false });
    }
  },

  fetchResult: async (resultId) => {
    set({ loading: true, error: null });

    try {
      const result = await fetchExamResultApi(resultId);
      set({ currentResult: result });
      return result;
    } catch (err) {
      set({ error: err.message });
      throw err;
    } finally {
      set({ loading: false });
    }
  },

  fetchHistory: async () => {
    set({ loading: true, error: null });

    try {
      const history = await fetchExamHistoryApi();
      set({ history });
      return history;
    } catch (err) {
      set({ error: err.message });
      throw err;
    } finally {
      set({ loading: false });
    }
  },

  clearCurrentResult: () => set({ currentResult: null }),
}));
```

